# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Secrets -- never commit real API keys. .env.example is the template that
# IS committed; a real .env (any variant) never should be.
.env
.env.*
!.env.example

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Local scratch / logs
*.log
scratch_*.json
/tmp/

# Large generated data (keep the real dataset itself, ignore ad-hoc exports)
data/processed/*.parquet
data/processed/*.csv
data/processed/*.json
!data/raw/real_channel_journeys.csv

# Prefect local orchestration state (self-hosted, no server needed for
# ad-hoc runs -- see orchestration/attribution_flow.py)
.prefect/

# Local working notes (council transcripts, demo script) -- not for the public repo
_local/
