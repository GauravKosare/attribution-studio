# Copy this file to .env (same directory) and fill in whichever keys you
# have. Loaded automatically by dashboards/server.py via python-dotenv --
# nothing else in this project needs a .env file. .env itself is gitignored;
# never commit real keys.
#
# You need at least ONE of these for the AI executive summary feature
# (src/ai_insights.py) to work. None of them are required for anything
# else in this project -- every other feature works with zero keys set.
# Tried in this order, falling through automatically on a missing key or a
# failed call: Gemini -> Groq -> Anthropic.

# Free, no card -- https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Free, no card -- https://console.groq.com/keys
GROQ_API_KEY=

# Paid, optional last-resort fallback -- https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
